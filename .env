# Flip these, save, then run: docker compose up -d
# (compose recreates only the containers whose resolved config changed)

CACHE_MODE=off
STAMPEDE_PROTECTION=off
BATCH_QUERY=off
CIRCUIT_BREAKER=off
WRITE_MODE=race
READ_MODE=replica
DUALWRITE_MODE=naive
CRASH_PROBABILITY=0
IDEMPOTENCY=off
INVALIDATE_ON_WRITE=off
REPLICATION_DELAY_MS=3000
